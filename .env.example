# Copia este archivo a .env y completa los valores reales. Nunca commitees .env.

# MongoDB Atlas (requerido)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sonambulosbot

# Servidor
PORT=3000
NODE_ENV=production

# Clave de tesorero para /emit, /users y POST /admin/setup.
# Si no se define, el servidor genera una temporal en cada arranque y la
# imprime en el log — configúrala explícitamente para producción.
ADMIN_PASSWORD=

# Secreto con el que se firman las sesiones. OPCIONAL: si no se define, el
# servidor genera uno la primera vez y lo guarda en la base, así que sobrevive
# a los reinicios igual. Defínelo solo si quieres rotarlo a mano.
SESSION_SECRET=

# Telegram: canal principal de avisos. Gratis. Se crea con @BotFather.
# TELEGRAM_BOT_USERNAME va sin la arroba.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Solo si Railway no expone RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=

# SMS: respaldo de pago para quien no vincule Telegram.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_COUNTRY_CODE=+57

# Cuenta a la que /bar manda las monedas (el número del bar del evento).
# Sin esto, /bar avisa que falta configurarlo y la consola no muestra el
# botón de pagar en el bar.
BAR_PHONE=

# Número (solo dígitos, se normaliza a los últimos 10) que se promueve
# automáticamente a admin la primera vez que entra.
TREASURER_PHONE=

BOT_NAME=Piso 26
EVENT_ID=event_oct3_2026
